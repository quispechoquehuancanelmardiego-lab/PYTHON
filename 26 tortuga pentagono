#practica 26
# dibuja un pentagono con la tortuga
import  turtle

import os
os.system("cls")

pantalla=turtle.Screen()
pantalla.bgcolor("black")
#objeto para crear
t1=turtle.Turtle()
#atributos
t1.shape("turtle")  #apariencia
t1.color("green")  #color del lapiz#
t1.pensize("3")    #grosor del lapiz
t1.speed(1)
#metodo (acciones a realizar)
t1.color("green") #color de lapiz
t1.pensize(1)   #grosor de lapiz
t=40
t1.begin_fill()
t1.goto(0*t,6*t)
t1.goto(-6*t, 1.5*t)
t1.goto(-4*t, -5.5*t)
t1.goto(4*t, -5.5*t)
t1.goto(6*t, 1.5*t)
t1.goto(0*t, 6*t)

t1.end_fill()
turtle.done()
