import  turtle

import os
os.system("cls")
pantalla=turtle.Screen()
pantalla.bgcolor("black")
#objeto para crear
t1=turtle.Turtle()
#atributos
t1.shape("turtle")  #apariencia
t1.color("green")  #color del lapiz#
t1.pensize("3")    #grosor del lapiz
t1.speed(1)
#metodo (acciones a realizar)
t1.color("green") #color de lapiz
t1.pensize(1)   #grosor de lapiz
t=50
t1.begin_fill()
t1.goto(0*t,4*t)
t1.goto(-2*t, 1.5*t)
t1.goto(-1*t, 1.5*t)
t1.goto(-3*t, -0.5*t)
t1.goto(-1.5*t, -1*t)
t1.goto(-3.5*t, -3*t)
t1.goto(0*t, -3.5*t)
t1.goto(3.5*t, -3*t)
t1.goto(1.5*t, -1*t)
t1.goto(3*t, -0.5*t)
t1.goto(1*t, 1.5*t)
t1.goto(2*t, 1.5*t)
t1.goto(0*t,4*t)
t1.end_fill()
#
#tronco
t1.penup()
t1.color("brown") #color de lapiz
t1.pensize(3)   #grosor de lapiz
t1.begin_fill()
t1.goto(-0.5*t, -3.5*t)
t1.pendown()
t1.goto(-0.5*t, -4.5*t)
t1.goto(0.5*t, -4.5*t)
t1.goto(0.5*t, -3.5*t)
t1.goto(-0.5*t, -3.5*t)
t1.end_fill()
turtle.done()

